#!/bin/bash
# Pre-commit hook: Security checks for secrets and dangerous code patterns

echo "Pre-commit: Running security checks..."

# Check 1: Hardcoded secrets in config files
echo "  [1/3] Checking for hardcoded secrets..."
if grep -r "ClientSecret\|password.*=" . --include="*.json" --include="*.cs" 2>/dev/null | grep -v ".git\|bin\|obj\|reports\|git-hooks" | grep -E "['\"].*['\"]" > /dev/null; then
    echo "BLOCKED: Potential hardcoded secrets detected!"
    echo "Review appsettings.json and config files."
    exit 1
fi

# Check 2: SQL Injection patterns (string concatenation in SQL queries)
echo "  [2/3] Checking for SQL injection vulnerabilities..."
if grep -r "\$\"SELECT\|\$\"INSERT\|\$\"UPDATE\|\$\"DELETE" . --include="*.cs" 2>/dev/null | grep -v ".git\|bin\|obj\|reports\|git-hooks" > /dev/null; then
    echo "BLOCKED: Potential SQL injection detected!"
    exit 1
fi

# Check 3: Command Injection patterns (Process.Start with string interpolation)
echo "  [3/3] Checking for command injection vulnerabilities..."
if grep -r "Arguments.*\$\"\|FileName.*\$\"" . --include="*.cs" 2>/dev/null | grep -v ".git\|bin\|obj\|reports\|git-hooks" | grep -i "process" > /dev/null; then
    echo "BLOCKED: Potential command injection detected!"
    exit 1
fi

echo "Pre-commit checks passed"
exit 0
